generator client {
  provider   = "prisma-client" // or `prisma-client-js`
  output     = "../generated/prisma"
  engineType = "client" // enable Prisma ORM without Rust
}

datasource db {
  provider = "postgresql"
  //url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 관계 설정
  bookmarks  Bookmark[]
  activities Activity[]

  // 내가 방을 만든 매칭 (UserA)
  matches  Match[]   @relation("UserAMatches")
  payments Payment[]
}

model Match {
  id        String      @id @default(uuid())
  userAId   String
  userBId   String? // 매칭 대기 중일 때는 null
  placeId   String // 카카오 맵 place_id
  placeName String // 가게 이름
  status    MatchStatus @default(PENDING)
  createdAt DateTime    @default(now())

  isNoShow     Boolean @default(false)
  noShowUserId String? // 노쇼한 유저의 ID 저장

  // 관계 설정
  userA    User      @relation("UserAMatches", fields: [userAId], references: [id])
  payments Payment[]
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  placeId   String // 카카오 place_id
  placeName String
  category  String? // 일식, 한식 등
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, placeId]) // 중복 찜 방지
}

model Activity {
  id        String   @id @default(uuid())
  userId    String
  type      String // "MATCH_CREATED", "MATCH_SUCCESS", "BOOKMARK_ADDED"
  content   String // 알림 텍스트
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum MatchStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

model Payment {
  id          String        @id @default(uuid())
  matchId     String
  userId      String
  amount      Int           @default(5000)
  status      PaymentStatus @default(READY) // READY, PAID, CANCELLED, REFUNDED
  impUid      String? // 포트원(아임포트) 등 외부 결제 고유 ID (환불 시 필요)
  merchantUid String        @unique // 우리 서버가 생성한 주문번호
  paidAt      DateTime?

  match Match @relation(fields: [matchId], references: [id])
  user  User  @relation(fields: [userId], references: [id])
}

enum PaymentStatus {
  READY
  PAID // 결제 완료
  REFUNDED // (매칭 실패 시) 환불 완료
  COMPLETED // 정상 식사 후 할인 적용 완료
  COMPENSATED // 노쇼 발생 시 상대방에게 보상금으로 넘어감
}
